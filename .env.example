# Supabase
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase PostgreSQL (used by Prisma)
DATABASE_URL=postgresql://postgres.your-instance:your-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.your-instance:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# OpenRouter AI
# Get keys at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here
